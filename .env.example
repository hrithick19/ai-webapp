# Local development only. Do not copy these development values to Koyeb.
DEBUG=True
SECRET_KEY=

# Neon pooled PostgreSQL connection string. Leave blank for local SQLite.
DATABASE_URL=

# Comma-separated hostnames/origins; adjust for your deployed domains.
ALLOWED_HOSTS=localhost,api.aharathi.in,www.aharathi.in,possible-sylvia-hrithick-23503e7d.koyeb.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://aharathi.in,https://www.aharathi.in,https://ai-webapp-liard.vercel.app

# Cloudflare R2: set all four required values to enable remote media storage.
# Leave them blank to keep Django's local filesystem media storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Optional hostname only (no scheme). Configure as a public custom domain
# for the bucket before setting this; otherwise Django uses signed R2 URLs.
R2_PUBLIC_DOMAIN=

# Create the Django admin user interactively after database migrations.
# Do not store superuser passwords in this file or deployment build variables.
